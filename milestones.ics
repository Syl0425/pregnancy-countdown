BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//daopai//pregnancy-countdown//CN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:备孕生产·关键里程碑
X-PUBLISHED-TTL:PT1H
BEGIN:VEVENT
UID:itm-0007@daopai
DTSTAMP:20261102T000239
DTSTART;VALUE=DATE:20270908
SUMMARY:NT 检查（孕11-13+6周）
DESCRIPTION:早期排畸超声，需提前预约；超过孕14周无法做\
 n建议提醒时间 09:00（全天事件，以系统默认提醒为准）\
 n规则: lmp+12W
CATEGORIES:备孕生产倒排表
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-P7D
DESCRIPTION:NT 检查（孕11-13+6周）
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:itm-0009@daopai
DTSTAMP:20261102T000239
DTSTART;VALUE=DATE:20271117
SUMMARY:大排畸（系统超声，孕20-24周）
DESCRIPTION:最重要的排畸检查，提前1个月预约\n建议提醒时
 间 09:00（全天事件，以系统默认提醒为准）\n规则: lmp+22W
CATEGORIES:备孕生产倒排表
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-P7D
DESCRIPTION:大排畸（系统超声，孕20-24周）
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:itm-0011@daopai
DTSTAMP:20261102T000239
DTSTART;VALUE=DATE:20271229
SUMMARY:进入孕晚期：开始数胎动
DESCRIPTION:每日早中晚各数1小时胎动，异常（2小时<10次）
 及时就医；产检转为每2周一次\n建议提醒时间 09:00（全
 天事件，以系统默认提醒为准）\n规则: lmp+28W
CATEGORIES:备孕生产倒排表
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-P1D
DESCRIPTION:进入孕晚期：开始数胎动
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:itm-0013@daopai
DTSTAMP:20261102T000239
DTSTART;VALUE=DATE:20280301
SUMMARY:足月：随时可能发动
DESCRIPTION:留意临产征兆：规律宫缩、见红、破水（破水立
 即平躺就医）；产检每周一次\n建议提醒时间 09:00（全天
 事件，以系统默认提醒为准）\n规则: lmp+37W
CATEGORIES:备孕生产倒排表
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-P1D
DESCRIPTION:足月：随时可能发动
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:itm-0014@daopai
DTSTAMP:20261102T000239
DTSTART;VALUE=DATE:20280322
SUMMARY:预产期
DESCRIPTION:预产期当天分娩概率约5%，孕41周未发动需入院
 催产\n建议提醒时间 09:00（全天事件，以系统默认提醒为
 准）\n规则: due+0W
CATEGORIES:备孕生产倒排表
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-P3D
DESCRIPTION:预产期
END:VALARM
END:VEVENT
END:VCALENDAR
